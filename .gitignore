# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cache do Python (scripts de ferramentas/)
__pycache__/
*.pyc
capas/

# Cópias de trabalho dos agentes do Claude Code (git worktree).
# Um `git add -A` chegou a gravar uma delas como repositório embutido.
.claude/worktrees/

# Cópias do banco antes de limpezas. Nunca vão pro git: têm telefone de
# cliente.
backups/

# ⚠️ AS FOTOS ORIGINAIS DAS CLIENTES.
#
# São rostos de pessoas reais, ~30 MB, e ficaram versionadas até 16/09/2026
# por descuido. Saíram do git nessa data; continuam no disco, que é onde
# precisam estar pra `ferramentas/fotos.py` reprocessar.
#
# O que VAI pro git é o resultado tratado, em `public/fotos/` — e mesmo
# esse depende da autorização foto a foto, que ainda está em aberto com a
# Karol.
#
# Elas continuam no HISTÓRICO do git (reescrever histórico é pior remédio
# que a doença). Por isso o repositório é privado.
ferramentas/originais/

# Os scripts que geraram os formulários do briefing. Uso único, em
# agosto/2026: cumpriram o papel e não rodam de novo.
briefing/
