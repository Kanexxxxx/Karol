# HTTPS automatico. O Caddy pede o certificado no Let's Encrypt sozinho,
# na primeira vez que alguem abre o site, e renova sozinho depois.
#
# Pre-requisito: o dominio ja tem que estar apontando pro IP desta VPS
# (registro A), e as portas 80 e 443 abertas no firewall. Sem isso o
# Let's Encrypt nao consegue validar e o site fica em HTTP.

{$DOMINIO} {
	encode gzip zstd

	# O Next ja manda os cabecalhos de seguranca (ver next.config.ts).
	# O Caddy so nao pode atrapalhar: passa o host e o IP real adiante,
	# senao o site acha que todo mundo e o proprio Caddy.
	reverse_proxy site:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output file /data/acesso.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
