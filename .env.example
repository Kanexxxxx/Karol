# -------------------------------------------------------------------
# Studio Karol Carvalho — variáveis de ambiente
# -------------------------------------------------------------------
# Copie para `.env.local` e preencha. Nunca comite o `.env.local`.
# O site institucional funciona SEM nada disto; só a agenda online e o
# painel precisam das variáveis abaixo.

# --- Supabase (agenda online) --------------------------------------
# Project Settings -> API, no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Chave "service_role" (secreta). NÃO use a anon aqui — o servidor
# precisa passar por cima do RLS. Nunca vai pro navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Painel da Karol ---------------------------------------------------
# Senha única de acesso a /painel (você e a Karol usam a mesma).
SENHA_PAINEL=
# Segredo pra assinar o cookie de sessão do painel. Gere um valor longo
# e aleatório, ex.: `openssl rand -base64 32`
SESSAO_SECRET=

# --- Notificações (opcional, ainda não obrigatório) -----------------
# WhatsApp da Karol que recebe o aviso de novo agendamento.
# Só dígitos, com DDI+DDD. Se vazio, usa o número de src/data/negocio.ts.
KAROL_WHATSAPP=
