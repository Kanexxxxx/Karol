# -------------------------------------------------------------------
# Studio Karol Carvalho — variáveis de ambiente
# -------------------------------------------------------------------
# Copie para `.env.local` e preencha. Nunca comite o `.env.local`.
# O site institucional funciona SEM nada disto; só a agenda online e o
# painel precisam das variáveis abaixo.

# --- Supabase (agenda online) --------------------------------------
# Project Settings -> API, no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Chave "service_role" (secreta). NÃO use a anon aqui — o servidor
# precisa passar por cima do RLS. Nunca vai pro navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Painel da Karol ---------------------------------------------------
# Senha única de acesso a /painel (você e a Karol usam a mesma).
SENHA_PAINEL=
# Segredo pra assinar o cookie de sessão do painel. Gere um valor longo
# e aleatório, ex.: `openssl rand -base64 32`
SESSAO_SECRET=

# --- Notificações (opcional) ---------------------------------------
# WhatsApp da Karol que recebe o aviso de novo agendamento.
# Só dígitos, com DDI+DDD. Se vazio, usa o número de src/data/negocio.ts.
KAROL_WHATSAPP=

# Webhook pra onde os eventos de notificação são enviados (POST JSON).
# Pode ser um n8n, Make, Zapier, uma função própria — qualquer coisa que
# receba o JSON e mande o WhatsApp/SMS de verdade. Sem isto, as mensagens
# são montadas mas não saem. Formato do corpo: ver src/lib/notificacoes.ts.
NOTIFICADOR_WEBHOOK_URL=

# Segredo do cron diário de lembretes (/api/lembretes). A Vercel injeta
# `Authorization: Bearer <CRON_SECRET>` sozinha quando esta var existe.
# Gere: openssl rand -hex 32
CRON_SECRET=

# --- Domínio público (opcional) -------------------------------------
# Usado no sitemap, no robots e na prévia de link. Sem isto, vale o
# domínio provisório definido em src/data/negocio.ts.
NEXT_PUBLIC_SITE_URL=

# --- Fuso do servidor (OBRIGATÓRIA em produção) ---------------------
# O motor de horários trabalha em hora local e assume que é a do Brasil.
# Na Vercel o padrão é UTC: sem isto, 07:00 vira 04:00 na agenda, sem
# erro nenhum na tela. Localmente sua máquina já está no fuso certo.
TZ=America/Sao_Paulo
